{
 "bio_epidemic_modeling": {"type":"ode","t":160,"vars":[{"id":"S","init":"1-0.001","f":"-beta*S*I","label":"susceptible","color":"accent"},{"id":"I","init":0.001,"f":"beta*S*I-gamma*I","label":"infected","color":"pink"},{"id":"R","init":0,"f":"gamma*I","label":"recovered","color":"green"}],"y":[0,1],"xlabel":"days","ylabel":"fraction of population","params":[{"id":"beta","label":"transmission β (per day)","min":0.05,"max":0.8,"value":0.3},{"id":"gamma","label":"recovery γ (per day)","min":0.03,"max":0.5,"value":0.1}],"readouts":[{"label":"R₀ = β/γ","value":"beta/gamma"},{"label":"herd-immunity threshold","value":"max(0,1-gamma/beta)*100","unit":"%"}],"caption":"The SIR model, solved numerically. Raise β or lower γ and the epidemic peaks sooner and higher; when R₀ falls below 1 it never takes off."},
 "bio_competition_predation": {"type":"ode","t":60,"steps":2400,"vars":[{"id":"N","init":10,"f":"a*N-b*N*P","label":"prey","color":"green"},{"id":"P","init":5,"f":"c*b*N*P-d*P","label":"predators","color":"pink"}],"xlabel":"time (years)","ylabel":"population","params":[{"id":"a","label":"prey birth rate","min":0.2,"max":1.5,"value":1},{"id":"b","label":"predation rate","min":0.02,"max":0.2,"value":0.1},{"id":"c","label":"conversion efficiency","min":0.1,"max":1,"value":0.5},{"id":"d","label":"predator death rate","min":0.1,"max":1.2,"value":0.5}],"readouts":[{"label":"prey equilibrium d/(cb)","value":"d/(c*b)"},{"label":"predator equilibrium a/b","value":"a/b"}],"caption":"Lotka–Volterra predator–prey cycles, solved numerically: predators peak just after their prey, then crash, letting prey recover."}
